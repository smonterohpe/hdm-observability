# Copia este fichero a .env y ajusta los valores para tu entorno

# ZVMA de origen (site de producción / "Remote")
ORIGIN_ZVMA_HOST=zvma-origin.tu-dominio.local
ORIGIN_ZVMA_USERNAME=admin@local
ORIGIN_ZVMA_PASSWORD=CAMBIA_ESTA_PASSWORD
ORIGIN_ZVMA_LABEL=HDM Production

# ZVMA de destino (site de recuperación / "Local")
DESTINATION_ZVMA_HOST=zvma-destination.tu-dominio.local
DESTINATION_ZVMA_USERNAME=admin@local
DESTINATION_ZVMA_PASSWORD=CAMBIA_ESTA_PASSWORD
DESTINATION_ZVMA_LABEL=HDM DR

# Client ID de Keycloak configurado en el ZVMA
KEYCLOAK_CLIENT_ID=zerto-client

# Certificado autofirmado -> false
VERIFY_SSL=false

CACHE_TTL_SECONDS=5
